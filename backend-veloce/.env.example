# Server
PORT=5000
NODE_ENV=development

# Database (single connection string, used by Drizzle + drizzle-kit)
# Local Docker Postgres defaults from the legacy backend: port 5433.
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/medical_appointments

# JWT
JWT_SECRET=change_me_super_secret
JWT_REFRESH_SECRET=change_me_super_secret_refresh
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

# Email (Gmail SMTP via nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# CORS — comma separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Demostración pública. Entrega sesiones sin contraseña, así que nunca va en
# true contra una base con datos de personas reales.
DEMO_MODE=false
DEMO_RATE_LIMIT_MAX=40

# Detrás de nginx, para que el limitador vea la IP del visitante y no la del proxy.
TRUST_PROXY_HOPS=0

# Archivos adjuntos de los documentos clínicos. En el VPS es un volumen de
# Docker; en desarrollo, una carpeta del repo que .gitignore ignora.
UPLOADS_DIR=./data/uploads
UPLOAD_RATE_LIMIT_MAX=20
