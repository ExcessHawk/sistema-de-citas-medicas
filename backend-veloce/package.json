{
  "name": "backend-veloce",
  "version": "0.1.0",
  "description": "Medical appointments API built with Veloce-TS",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "generate:openapi": "bun run node_modules/veloce-ts/bin/veloce.ts generate openapi",
    "generate:client": "bun run node_modules/veloce-ts/bin/veloce.ts generate client",
    "demo:seed": "bun run scripts/demo-seed.mjs",
    "demo:reset": "bun run scripts/demo-reset.mjs",
    "demo:refresh": "bun run scripts/demo-reset.mjs && bun run scripts/demo-seed.mjs",
    "smoke": "bun run scripts/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.0",
    "veloce-ts": "3.5.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0",
    "drizzle-kit": "^0.31.10",
    "@types/pg": "^8.20.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.14"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
